@HealthTech_HostAddress = http://localhost:5089
@JobId = 00000000-0000-0000-0000-000000000000

### Типы записей для выпадашки при загрузке
GET {{HealthTech_HostAddress}}/profiles
Accept: application/json

###
# Загрузка файла и запуск обработки. Возвращает { "jobId": "..." } сразу,
# не дожидаясь конца обработки. Multipart из .http-файла неудобен, проще curl:
#
#   curl.exe -X POST http://localhost:5089/jobs \
#     -F "file=@assets/input/Medpark_audio_2min.m4a" \
#     -F "profile=consilium"

### Список заданий, новые сверху
GET {{HealthTech_HostAddress}}/jobs
Accept: application/json

### Статус задания: status, currentStep, percent, error
# currentStep внутри долгих шагов уточняется: "Распознавание: чанк 3 из 7".
GET {{HealthTech_HostAddress}}/jobs/{{JobId}}
Accept: application/json

### Результат: транскрипт со спикерами и диалогом
GET {{HealthTech_HostAddress}}/jobs/{{JobId}}/result
Accept: application/json

### Повторная коррекция терминов в уже готовом файле из transcripts/
# Позволяет крутить глоссарии и промпты, не переплачивая за распознавание.
# Имя файла — без каталогов; ".json" можно опустить.
POST {{HealthTech_HostAddress}}/audio/correctTranscript?fileName=Medpark_audio_2min.speakers.json&profile=consilium
Accept: application/json
