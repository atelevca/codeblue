{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "http://localhost:5089",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "GGML_VK_VISIBLE_DEVICES": "1"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "https://localhost:7059;http://localhost:5089",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "GGML_VK_VISIBLE_DEVICES": "1"
      }
    },
    "mac": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "http://localhost:5089",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "WHISPER_GPU_DEVICE": "0",
        "Llm__GpuLayerCount": "999",
        "Llm__ContextSize": "32768",
        "Llm__MaxTokens": "4096",
        "Minutes__MaxTranscriptCharacters": "55000",
        "Minutes__MaxVerificationCharacters": "65000",
        "Minutes__ExtractionMaxTokens": "4096",
        "Minutes__VerificationMaxTokens": "4096"
      }
    }
  }
}
