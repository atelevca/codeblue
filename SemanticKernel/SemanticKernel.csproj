<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- All LLamaSharp packages must have the same version. -->
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.semantic-kernel" Version="0.27.0" />
    <!--
      Vulkan backend (Intel Arc / any Vulkan GPU) with the CPU backend as the fallback LLamaSharp picks on its
      own when no Vulkan device is usable. Llm:GpuLayerCount says how many layers go to the GPU (0 = CPU only).
      For an NVIDIA GPU, LLamaSharp.Backend.Cuda12 (same version, CUDA 12 runtime required) is the faster choice.
    -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.80.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.llm.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Prompts\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Glossary\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
